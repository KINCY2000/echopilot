# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# --- Supabase (Module 2/3) ---------------------------------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OpenAI (Module 5/6 — analyse & génération de réponses IA) ----------
OPENAI_API_KEY=

# --- Stripe (Module 9 — abonnements) -------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Business Profile (Module 4 — OAuth) --------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Resend (Module 10 — emails transactionnels) -------------------------
RESEND_API_KEY=

# --- n8n (Module 11 — automatisations) ------------------------------------
# Shared secret used to verify inbound webhooks from n8n workflows.
N8N_WEBHOOK_SECRET=
